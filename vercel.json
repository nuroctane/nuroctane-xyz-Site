{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y pnpm@10 install --no-frozen-lockfile",
  "buildCommand": "",
  "outputDirectory": "og-static",
  "functions": {
    "api/og.mjs": { "maxDuration": 10 }
  },
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "https://nuroctane-xyz.civetadeicollegium.workers.dev/$1"
    }
  ]
}
