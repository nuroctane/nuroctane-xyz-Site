    "@workspace/kv": "workspace:*",
    "hono": "^4.12.32",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "catalog:"
  }
}
