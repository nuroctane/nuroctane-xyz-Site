VITE_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# PostHog's project key is public by design and is embedded in the Vite bundle.
VITE_POSTHOG_KEY=phc_your_posthog_project_key
# Managed PostHog reverse proxy (i.nuroctane.xyz)
VITE_POSTHOG_HOST=https://i.nuroctane.xyz
VITE_POSTHOG_UI_HOST=https://us.posthog.com
